#!/usr/bin/env ruby
# Preflight lint for milestone-orchestrator PREPARE artifacts. Catches the
# self-inflicted defects observed across real runs before RUN starts:
# unresolved decision markers, verification commands that cannot run from a
# fresh checkout, absolute-path portability traps, long gates without an
# execution policy, repo contract files no task owns, gating quantities frozen
# without a recorded measurement, and concurrent tasks sharing owned paths.
#
# Usage:
#   preflight-lint MILESTONE_DIR [--repo DIR]
#
# MILESTONE_DIR holds SPEC.md and PLAN.md. --repo defaults to the git
# toplevel containing MILESTONE_DIR.
#
# Output: one finding per line (`ERROR code path message` / `WARN ...`).
# Exit codes: 0 no errors (warnings allowed), 1 errors present, 2 usage.
require "json"
require "tempfile"

PLAN_OPEN_MARKER = "<!-- milestone-orchestrator-plan:v1 -->".freeze
PLAN_CLOSE_MARKER = "<!-- /milestone-orchestrator-plan -->".freeze
LONG_GATE_SECONDS = 600
CONTRACT_FILE_PATTERN = /\A(PROJECT_STATUS|STATUS|CHANGELOG)[^\/]*\z/i

# Threshold-shaped prose: a comparison against a number, a bounded phrase, or a
# multiplier. Deliberately narrow — a false WARN costs a glance, but noise here
# trains coordinators to skip the whole report.
GATING_QUANTITY_PATTERNS = [
  /[≤≥](?:\s*)\d/,
  /[<>]=?\s*\d/,
  /\b(?:at least|at most|no more than|no fewer than|must not exceed|may not exceed)\s+\d/i,
  /\b\d+(?:\.\d+)?x\b/,
].freeze
MEASUREMENT_FILE_PATTERN = /measurement/i
MEASUREMENT_HEADING_PATTERN = /^\#{1,6}\s.*\b(?:measurement|calibrat\w*|baseline)\b/i

def usage!(message)
  warn message
  exit 2
end

args = ARGV.dup
usage!("usage: preflight-lint MILESTONE_DIR [--repo DIR]") if args.empty?
dir = args.shift
usage!("no such directory: #{dir}") unless File.directory?(dir)
options = {}
until args.empty?
  arg = args.shift
  usage!("unexpected argument #{arg.inspect}") unless arg.start_with?("--")
  value = args.shift
  usage!("#{arg} requires a value") if value.nil?
  options[arg[2..-1]] = value
end

dir = File.expand_path(dir)
repo = options["repo"]
if repo.nil?
  toplevel = `git -C #{dir.inspect} rev-parse --show-toplevel 2>/dev/null`.strip
  repo = toplevel.empty? ? dir : toplevel
end
repo = File.expand_path(repo)

findings = []
add = lambda do |severity, code, path, message|
  findings << [severity, code, path, message]
end

# --- unresolved decision markers in SPEC/PLAN prose ---

%w[SPEC.md PLAN.md].each do |name|
  path = File.join(dir, name)
  unless File.file?(path)
    add.call("ERROR", "missing_artifact", name, "#{name} not found in #{dir}")
    next
  end
  File.read(path).each_line.with_index(1) do |line, lineno|
    if line =~ /\b(TBD|TODO|FIXME)\b/
      add.call("ERROR", "unresolved_marker", "#{name}:#{lineno}",
               "unresolved #{$1} marker; intake requires none at approval")
    end
    if line =~ /<(?:decide|placeholder|fill[- ]?in)[^>]*>/i
      add.call("ERROR", "unresolved_marker", "#{name}:#{lineno}",
               "unresolved placeholder token #{$~[0].inspect}")
    end
  end
end

# --- gating quantities frozen without a recorded measurement ---
#
# Four owner-authorized SPEC amendments in one field run all froze a threshold,
# aggregation rule, or population rule before anyone measured the distribution
# it had to survive. The check is heuristic (prose, not schema), so it warns.

spec_path = File.join(dir, "SPEC.md")
if File.file?(spec_path)
  spec_text = File.read(spec_path)
  gating_lines = spec_text.each_line.with_index(1).select do |line, _|
    GATING_QUANTITY_PATTERNS.any? { |pattern| line =~ pattern }
  end

  unless gating_lines.empty?
    has_measurement_file =
      Dir.children(dir).any? { |f| f =~ MEASUREMENT_FILE_PATTERN && File.file?(File.join(dir, f)) }
    plan_md = File.join(dir, "PLAN.md")
    plan_text = File.file?(plan_md) ? File.read(plan_md) : ""
    has_measurement_section =
      [spec_text, plan_text].any? { |text| text =~ MEASUREMENT_HEADING_PATTERN }

    unless has_measurement_file || has_measurement_section
      sample = gating_lines.first(3).map { |_, lineno| "SPEC.md:#{lineno}" }.join(", ")
      add.call("WARN", "uncalibrated_gate", "SPEC.md",
               "#{gating_lines.length} threshold-shaped acceptance line(s) (#{sample}) with no " \
               "measurement record: add MEASUREMENT.md beside SPEC, or a measurement/calibration " \
               "section, recording the observed distribution and the command that produced it. " \
               "Pin each bound outside the observed range, not tight against one sample")
    end
  end
end

# --- canonical plan block checks ---

plan_path = File.join(dir, "PLAN.md")
plan = nil
if File.file?(plan_path)
  markdown = File.read(plan_path)
  open_at = markdown.index(PLAN_OPEN_MARKER)
  close_at = markdown.index(PLAN_CLOSE_MARKER)
  if open_at.nil? || close_at.nil?
    add.call("ERROR", "missing_plan_block", "PLAN.md", "no canonical plan block")
  else
    json_text = markdown[(open_at + PLAN_OPEN_MARKER.length)...close_at][/```json\s*\n(.*?)```/m, 1]
    if json_text.nil?
      add.call("ERROR", "missing_plan_block", "PLAN.md", "no ```json fence inside the plan block")
    else
      begin
        plan = JSON.parse(json_text)
      rescue JSON::ParserError => e
        add.call("ERROR", "invalid_json", "PLAN.md", "plan JSON does not parse: #{e.message}")
      end
    end
  end
end

if plan
  tasks = plan["tasks"] || {}
  commands = plan["verification_commands"] || {}

  # Executables must resolve from a fresh checkout: repo-relative or on PATH.
  # Windows carries the executable suffix in PATHEXT rather than a mode bit, so
  # a bare "ruby" only resolves once those suffixes are tried too.
  path_dirs = ENV.fetch("PATH", "").split(File::PATH_SEPARATOR)
  path_exts = ENV.fetch("PATHEXT", "").split(File::PATH_SEPARATOR)
  exe_candidates = lambda do |name|
    return [name] if path_exts.empty?

    [name] + path_exts.map { |extension| "#{name}#{extension}" }
  end
  separators = [File::SEPARATOR, File::ALT_SEPARATOR].compact
  commands.each do |command_id, command|
    next unless command.is_a?(Hash)
    argv = command["argv"]
    next unless argv.is_a?(Array) && argv.first.is_a?(String)
    exe = argv.first
    cwd = File.expand_path(command["cwd"] || ".", repo)
    resolvable =
      if separators.any? { |separator| exe.include?(separator) }
        exe_candidates.call(File.expand_path(exe, cwd)).any? { |c| File.executable?(c) }
      else
        path_dirs.any? do |d|
          exe_candidates.call(exe).any? { |c| File.executable?(File.join(d, c)) }
        end
      end
    unless resolvable
      add.call("ERROR", "missing_executable", "verification_commands.#{command_id}",
               "argv[0] #{exe.inspect} not executable from #{command["cwd"] || "."} or PATH; " \
               "gate would fail on a fresh checkout")
    end
    argv.each do |part|
      if part.start_with?("/") && !part.start_with?(repo)
        add.call("WARN", "absolute_path", "verification_commands.#{command_id}",
                 "argv contains absolute path #{part.inspect} outside the repository; " \
                 "evidence and commands should be repo-relative")
      end
    end
    timeout = command["timeout_seconds"]
    if timeout.is_a?(Integer) && timeout > LONG_GATE_SECONDS
      users = tasks.count { |_, t| t.is_a?(Hash) && (t["verification_command_ids"] || []).include?(command_id) }
      add.call("WARN", "long_gate", "verification_commands.#{command_id}",
               "timeout #{timeout}s marks this a long gate (referenced by #{users} task(s)): " \
               "run it coordinator-side via run-verification, never backgrounded inside a " \
               "worker, and register a fast targeted subset for per-task checks")
    end
  end

  # owned_paths escaping the repo
  tasks.each do |task_id, task|
    next unless task.is_a?(Hash)
    (task["owned_paths"] || []).each do |p|
      if p.start_with?("/") || p.split("/").include?("..")
        add.call("ERROR", "path_escape", "tasks.#{task_id}.owned_paths",
                 "owned path #{p.inspect} escapes the repository")
      end
    end
  end

  # state-schema.md: "Two implementation tasks that can run concurrently must
  # not share owned_paths." Concurrency is the absence of a transitive
  # depends_on edge either way, so this is computable rather than heuristic.
  impl = tasks.select { |_, t| t.is_a?(Hash) && t["type"] == "implementation" }
  reachable = impl.keys.to_h { |id| [id, Array(impl[id]["depends_on"]).dup] }
  loop do
    changed = false
    reachable.each do |id, deps|
      additions = deps.flat_map { |d| reachable[d] || [] }.uniq - deps - [id]
      next if additions.empty?
      deps.concat(additions)
      changed = true
    end
    break unless changed
  end

  covers = lambda do |a, b|
    a == b || b.start_with?("#{a.chomp("/")}/") || a.start_with?("#{b.chomp("/")}/")
  end

  impl.keys.combination(2) do |left, right|
    next if reachable[left].include?(right) || reachable[right].include?(left)
    shared = Array(impl[left]["owned_paths"]).select do |p|
      Array(impl[right]["owned_paths"]).any? { |q| covers.call(p, q) }
    end
    next if shared.empty?
    add.call("ERROR", "concurrent_path_overlap", "tasks.#{left}+#{right}",
             "#{left} and #{right} have no dependency edge either way, so they can run " \
             "concurrently, but both own #{shared.sort.inspect}; order them with depends_on " \
             "or split the ownership")
  end

  # Optional ownership predicates. A task may declare the search that defines
  # its owned paths; the lint re-runs it and fails on anything the frozen list
  # does not cover. Field replans added six files matching "constructs
  # Game.New" and ten runners needing a flag threaded through — both stated as
  # predicates in prose, both enumerated by hand, both incomplete.
  covered_by_owned = lambda do |emitted, owned|
    owned.any? { |o| emitted == o || emitted.start_with?("#{o.chomp("/")}/") }
  end

  tasks.each do |task_id, task|
    next unless task.is_a?(Hash)
    predicate = task["owned_paths_predicate"]
    next if predicate.nil?
    where = "tasks.#{task_id}.owned_paths_predicate"

    argv = predicate.is_a?(Hash) ? predicate["argv"] : nil
    unless argv.is_a?(Array) && !argv.empty? && argv.all? { |a| a.is_a?(String) }
      add.call("ERROR", "invalid_predicate", where,
               "must be an object with a non-empty argv array of strings (no shell strings)")
      next
    end

    cwd_rel = predicate["cwd"] || "."
    if cwd_rel.start_with?("/") || cwd_rel.split("/").include?("..")
      add.call("ERROR", "path_escape", where, "cwd #{cwd_rel.inspect} escapes the repository")
      next
    end

    timeout = predicate["timeout_seconds"]
    timeout = 60 unless timeout.is_a?(Integer) && timeout.positive?

    out_file = Tempfile.new("preflight-predicate")
    begin
      pid = Process.spawn(*argv, chdir: File.expand_path(cwd_rel, repo),
                          out: out_file.fileno, err: File::NULL, pgroup: true)
      deadline = Time.now + timeout
      status = nil
      timed_out = false
      loop do
        _, status = Process.waitpid2(pid, Process::WNOHANG)
        break if status
        if Time.now > deadline
          timed_out = true
          begin
            Process.kill("-KILL", pid)
          rescue Errno::ESRCH, Errno::EPERM
            begin
              Process.kill("KILL", pid)
            rescue Errno::ESRCH, Errno::EPERM
              nil
            end
          end
          _, status = Process.waitpid2(pid)
          break
        end
        sleep 0.05
      end
      out_file.flush
      emitted = File.read(out_file.path).split("\n").map(&:strip).reject(&:empty?)
    rescue Errno::ENOENT, Errno::EACCES => e
      add.call("ERROR", "predicate_failed", where, "cannot run #{argv.first.inspect}: #{e.message}")
      next
    ensure
      out_file.close
      out_file.unlink
    end

    if timed_out
      add.call("ERROR", "predicate_failed", where, "predicate exceeded #{timeout}s and was killed")
      next
    end
    if emitted.empty?
      add.call("ERROR", "predicate_failed", where,
               "predicate produced no paths (exit #{status&.exitstatus}); a declared predicate " \
               "that matches nothing cannot be validating the ownership list")
      next
    end

    owned = Array(task["owned_paths"])
    uncovered = emitted.reject { |p| covered_by_owned.call(p, owned) }.sort.uniq
    next if uncovered.empty?
    add.call("ERROR", "predicate_uncovered_path", "tasks.#{task_id}.owned_paths",
             "ownership predicate emits #{uncovered.length} path(s) the frozen owned_paths does " \
             "not cover: #{uncovered.first(8).inspect}#{uncovered.length > 8 ? " ..." : ""}; add " \
             "them now or narrow the predicate")
  end

  # Repo contract files (status ledgers, changelogs) that no task owns have
  # caused runtime ownership reconciliations in real runs.
  owned = tasks.values.select { |t| t.is_a?(Hash) }.flat_map { |t| t["owned_paths"] || [] }
  tracked = `git -C #{repo.inspect} ls-files 2>/dev/null`.split("\n")
  tracked.select { |f| f =~ CONTRACT_FILE_PATTERN }.each do |contract|
    next if owned.any? { |p| p == contract || contract.start_with?("#{p.chomp("/")}/") }
    add.call("WARN", "unowned_contract_file", contract,
             "repo contract file is owned by no task; if a repo gate requires updating it, " \
             "assign ownership now instead of reconciling mid-run")
  end
end

findings.each { |sev, code, path, message| puts "#{sev} #{code} #{path} #{message}" }
errors = findings.count { |sev, _, _, _| sev == "ERROR" }
puts "preflight-lint: #{errors} error(s), #{findings.length - errors} warning(s)"
exit(errors.zero? ? 0 : 1)
