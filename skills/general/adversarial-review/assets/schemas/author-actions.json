{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "artifact_digests",
    "actions",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "artifact_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[0-9a-f]{64}$",
        "maxLength": 8192
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "action",
          "rationale"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "action": {
            "enum": [
              "FIXED",
              "REJECTED"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "changed_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
              "maxLength": 8192
            },
            "maxItems": 256
          }
        }
      },
      "maxItems": 256
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      },
      "maxItems": 256
    }
  }
}
