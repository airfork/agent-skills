{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "artifact_digests",
    "groups",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "artifact_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[0-9a-f]{64}$",
        "maxLength": 8192
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group_id",
          "candidate_ids",
          "summary",
          "location",
          "source_angles"
        ],
        "properties": {
          "group_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "candidate_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^C-[a-z0-9-]+-[0-9]+-[0-9]+$",
              "maxLength": 8192
            },
            "maxItems": 256
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "line_start",
              "line_end",
              "heading"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              },
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
            }
          },
          "source_angles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "maxItems": 256
          }
        }
      },
      "maxItems": 256
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      },
      "maxItems": 256
    }
  }
}
