{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "artifact_digests",
    "decisions",
    "metrics",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "artifact_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[0-9a-f]{64}$",
        "maxLength": 8192
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject_id",
          "decision",
          "confidence",
          "evidence",
          "mapped_candidate_ids"
        ],
        "properties": {
          "subject_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "decision": {
            "enum": [
              "PROMOTE",
              "REFUTE",
              "UNPROVEN",
              "RESOLVED",
              "UNRESOLVED"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "mapped_candidate_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^C-[a-z0-9-]+-[0-9]+-[0-9]+$",
              "maxLength": 8192
            },
            "maxItems": 256
          }
        }
      },
      "maxItems": 256
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      },
      "maxItems": 256
    }
  }
}
