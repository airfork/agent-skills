{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "adversarial-review attacker result",
  "type": "object",
  "additionalProperties": false,
  "required": ["angle", "findings"],
  "properties": {
    "angle": {
      "enum": ["implementer", "tester", "feasibility", "pre-mortem"]
    },
    "findings": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "quote", "failure", "severity"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Repository-relative path of the file the quote is taken from."
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Verbatim text from the file at `path`. Checked byte-for-byte by scripts/check-quotes; an approximate quote discards the finding."
          },
          "heading": {
            "type": "string",
            "maxLength": 1024,
            "description": "Nearest enclosing heading, to locate the quote for a reader."
          },
          "failure": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "What breaks, when, and for whom. Not a property of the document."
          },
          "severity": {
            "enum": ["CRITICAL", "HIGH", "MEDIUM"]
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000},
      "description": "Optional. Checks performed that produced nothing, so a thin review reads as thin."
    }
  }
}
