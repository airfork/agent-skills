#!/usr/bin/env bash

set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT"

echo "==> Ruby syntax"
ruby -c scripts/sync-skills
ruby -c scripts/run-codex-5.6-skill-review
ruby -c skills/general/adversarial-review/scripts/check-quotes

echo "==> Shell syntax"
bash -n scripts/test scripts/verify scripts/clean scripts/archive-clean

echo "==> YAML syntax"
ruby -ryaml -e 'ARGV.each { |path| YAML.load_file(path); puts "YAML: OK #{path}" }' skills.yaml orca.yaml

echo "==> TOML syntax"
python3 -c 'import sys, tomllib; [tomllib.load(open(path, "rb")) for path in sys.argv[1:]]; print("TOML: OK .conductor/settings.toml")' .conductor/settings.toml

echo "==> JSON syntax"
ruby -rjson -e 'ARGV.each { |path| JSON.parse(File.read(path)); puts "JSON: OK #{path}" }' \
  skills/general/adversarial-review/assets/schemas/*.json

echo "==> Diff whitespace"
git diff --check

echo "==> Tests"
scripts/test
