#!/usr/bin/env ruby
require "json"
require_relative "lib/prompt_engineer"
require_relative "lib/prompt_engineer/sandbox/darwin"

if ARGV == ["status"]
  STDOUT.write(PromptEngineer::Canonical.json(PromptEngineer::Sandbox::Darwin.capability))
  STDOUT.write("\n")
  exit 0
end

if ARGV == ["probe", "--host", "claude", "--json"]
  STDOUT.write(JSON.generate(PromptEngineer::Sandbox.probe(host: "claude", platform: RUBY_PLATFORM)))
  STDOUT.write("\n")
  exit 3
end

if ARGV.first == "launch"
  STDERR.write(JSON.generate("error" => {"code" => "live_launch_unsupported", "message" => "sandbox launch is unsupported: host authentication and tool isolation evidence is unavailable"}))
  STDERR.write("\n")
  exit 3
end

STDERR.write(JSON.generate("error" => {"code" => "unsupported", "message" => "sandbox launch is unsupported: host authentication and tool isolation evidence is unavailable"}))
STDERR.write("\n")
exit 3
