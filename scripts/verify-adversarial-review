#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'HELP'
Usage: scripts/verify-adversarial-review [--root PATH]

Verify the portable adversarial-review package beneath PATH. PATH defaults to
the repository containing this script.
HELP
}

SCRIPT_ROOT=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
ROOT_ARGUMENT=$SCRIPT_ROOT

case "${1:-}" in
  "")
    ;;
  --root)
    if [[ $# -ne 2 ]]; then
      usage >&2
      exit 2
    fi
    ROOT_ARGUMENT=$2
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

ROOT=$(ruby -e 'puts File.realpath(ARGV.fetch(0))' "$ROOT_ARGUMENT")

canonical_beneath_root() {
  ruby -e '
    root = File.realpath(ARGV.fetch(0))
    path = File.realpath(ARGV.fetch(1))
    prefix = root.end_with?(File::SEPARATOR) ? root : root + File::SEPARATOR
    abort "package path escapes root: #{ARGV.fetch(1)}" unless path.start_with?(prefix)
    puts path
  ' "$ROOT" "$1"
}

SKILL_ROOT=$(canonical_beneath_root "$ROOT/skills/general/adversarial-review")
SCRIPTS_ROOT=$(canonical_beneath_root "$SKILL_ROOT/scripts")
SCHEMAS_ROOT=$(canonical_beneath_root "$SKILL_ROOT/assets/schemas")

require_package_file() {
  relative_path=$1
  absolute_path="$SKILL_ROOT/$relative_path"
  if [[ ! -f "$absolute_path" ]]; then
    echo "missing required package file: $relative_path" >&2
    exit 1
  fi
  canonical_beneath_root "$absolute_path" >/dev/null
}

while IFS= read -r linked_path; do
  echo "package symlink is not permitted: $linked_path" >&2
  exit 1
done < <(find "$SKILL_ROOT" -type l -print | LC_ALL=C sort)

require_package_file "scripts/adversarial-review"
require_package_file "scripts/lib/adversarial_review.rb"
for schema_name in attack divergence dedupe judge author-actions resolution arbiter; do
  require_package_file "assets/schemas/$schema_name.json"
done

echo "==> Adversarial-review Ruby syntax"
while IFS= read -r ruby_file; do
  canonical_file=$(canonical_beneath_root "$ruby_file")
  echo "Ruby: $canonical_file"
  ruby -c "$canonical_file"
done < <(find "$SCRIPTS_ROOT" -type f \( -name '*.rb' -o -name 'adversarial-review' \) -print | LC_ALL=C sort)

echo "==> Adversarial-review JSON schemas"
while IFS= read -r schema_file; do
  canonical_file=$(canonical_beneath_root "$schema_file")
  echo "JSON: $canonical_file"
  ruby -rjson -e 'JSON.parse(File.read(ARGV.fetch(0)))' "$canonical_file"
done < <(find "$SCHEMAS_ROOT" -type f -name '*.json' -print | LC_ALL=C sort)
